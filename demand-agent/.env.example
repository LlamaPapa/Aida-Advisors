# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_key_here

# Server port (optional, default 3003)
PORT=3003

# Safety: maximum loop iterations per run (default 8)
DEMAND_AGENT_MAX_ITERATIONS=8

# Safety: maximum total Claude tokens to spend per run (default 2000000)
DEMAND_AGENT_MAX_TOKENS=2000000
